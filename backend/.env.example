# Copy to backend/.env and fill in, or set these as real environment variables
# on the server (they take precedence over the file). ENV_FILE=/path/to/file
# reads a different file instead of backend/.env.

# --- connection -------------------------------------------------------------
# IMPORTANT: use a MongoDB user that holds ONLY the `read` role.
# In Atlas: Database Access -> Add New Database User -> Built-in Role "Only read
# any database" (or a custom role with `read` on Top40ThinkTanks alone).
# The application never writes, but a read-only user makes that structural.
# Also add the server's IP address under Atlas -> Network Access.
MONGO_URI=mongodb+srv://USER:PASSWORD@serverlessinstance0.6mjpz24.mongodb.net/?appName=CorpusExplorer
DB_NAME=Top40ThinkTanks
MASTER_COLLECTION=top_40_think_tanks

# --- the frontend ------------------------------------------------------------
# Every address the frontend is served from: scheme, host and port, no path,
# comma-separated. The browser refuses API responses for any other origin.
# Example for a server:  ALLOW_ORIGINS=https://explorer.example.org
ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173

# --- local files (relative paths resolve from backend/) ---------------------
# Corpus metadata produced by the profiling scripts; a copy ships in data/.
# KNOWLEDGE_PATH=data/corpus_knowledge.json
# Weekly statistics snapshot. Must be writable by the service.
# STATS_PATH=data/stats.json

# --- weekly statistics job --------------------------------------------------
# On by default. With more than one worker process, set 0 and run
# compute_stats.py from cron instead, or every worker recomputes separately.
# STATS_SCHEDULER=1

# --- limits (all optional) --------------------------------------------------
MAX_TIME_MS=20000
MAX_PAGE_SIZE=100
MAX_EXPORT_ROWS=5000

# --- optional: natural-language queries via an LLM --------------------------
# Leave blank to use the deterministic pattern parser only (no cost, no key).
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-4-5

# --- demo mode: in-memory fixtures, no cluster needed ------------------------
# DEMO_MODE=1
# KNOWLEDGE_PATH=fixtures/knowledge.demo.json
