# Copy to frontend/.env (optional). Only used at build / dev time.

# Backend address baked into the build as a fallback. public/config.js, which is
# editable after the build, takes precedence when its apiBase is set.
# VITE_API_BASE=https://api.explorer.example.org

# Where `npm run dev` and `npm run preview` forward /api. Defaults to the
# backend's local address.
# DEV_API_TARGET=http://localhost:8000
